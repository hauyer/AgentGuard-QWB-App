# =============================================================================
# AgentGuard-QWB-App environment template.
# Copy to .env (backend) and configure per deployment. Never commit real secrets.
# =============================================================================

# --- AgentGuard upstream (server-side only; the browser never sees this) ---
# Fixed upstream origin, validated at startup: http(s) only, no credentials,
# no path, no query, no fragment. The BFF is the only component that talks to
# AgentGuard; the frontend can never override it.
AGENTGUARD_BASE_URL=http://127.0.0.1:8000
# Optional API credential sent as X-AgentGuard-Token (leave empty when AgentGuard
# runs without authentication).
AGENTGUARD_API_TOKEN=
# Optional separate operator credential sent as X-AgentGuard-Operator-Token.
AGENTGUARD_OPERATOR_API_TOKEN=
# Request timeout in seconds (0 < t <= 120). GET retries use the same budget.
AGENTGUARD_API_TIMEOUT=15

# --- BFF application ---
# Deployment environment: development | demo | production (B9).
#   development/demo: demo accounts allowed, relaxed startup checks.
#   production: REQUIRES AUTH_ENABLED=true + APP_SECRET_KEY (>=32 chars) +
#               SESSION_COOKIE_SECURE=true + DATABASE_URL; startup fails
#               closed otherwise.
APP_ENV=development
# Host/port the FastAPI BFF binds to. Default binds loopback only; do not expose
# to the public internet without a trusted reverse proxy and authentication.
APP_HOST=127.0.0.1
APP_PORT=8001
# Explicit CORS origin allowlist, comma separated. Wildcard is rejected.
# The Vite dev server default is http://localhost:5173.
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Data mode override: live (default), recorded, synthetic, unavailable.
# Leave empty to derive the mode from AgentGuard connectivity. A forced `live`
# downgrades to unavailable when the upstream is down - LIVE is never faked.
APP_DATA_MODE=

# --- Frontend ---
# Base URL the browser uses to reach the BFF. The Vite dev proxy forwards /api
# to APP_HOST:APP_PORT, so this normally stays /api.
VITE_API_BASE=/api

# --- Application authentication (B8, hardened B9) ---
# AUTH_ENABLED=true enables the four-role model (viewer/analyst/operator/admin)
# and REQUIRES APP_SECRET_KEY (startup error without it - no fallback secret).
AUTH_ENABLED=false
# Strong random secret for HMAC-signed sessions/CSRF. Required whenever
# AUTH_ENABLED=true; >= 32 characters in production.
# Generate with: python -c "import secrets;print(secrets.token_hex(32))"
APP_SECRET_KEY=
# Production identities live in the users table with PBKDF2 password hashes.
# Create them with scripts/manage_users.py. Hardcoded demo accounts
# (username=<role>, password=<role>-demo) are ONLY honoured in APP_ENV
# development/demo; production ignores this flag and always refuses them.
AUTH_DEMO_USERS_ENABLED=
# Session lifetime in seconds (default 8h).
SESSION_MAX_AGE_SECONDS=28800
# Set SESSION_COOKIE_SECURE=true only when serving over HTTPS behind a trusted
# reverse proxy. Local HTTP development must keep this false.
SESSION_COOKIE_SECURE=false

# --- Database (production requires PostgreSQL; single-machine dev may use SQLite) ---
# DATABASE_URL=postgresql+psycopg://qwb:qwb@127.0.0.1:5432/agentguard_qwb
# DATABASE_URL=sqlite:///./app.db
# When set, the BFF runs Alembic migrations to head at startup; business audit
# events are persisted to app_audit_events (queryable, restart-safe) and
# database users become the production identity source.
